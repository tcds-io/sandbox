# Copy to .env (used by `npm run dev`). Every variable is optional.

# Port the sandbox API listens on.
PORT=4000
# Origin the sandbox is reachable at, used in links it returns (invoice URLs, base URLs shown in the UI).
PUBLIC_URL=http://localhost:4000

# Webhook delivery
WEBHOOK_MAX_ATTEMPTS=4
WEBHOOK_RETRY_BASE_MS=1000
WEBHOOK_TIMEOUT_MS=5000

# Asaas
# The key your app sends in the access_token header. Unset: any non-empty key is accepted.
ASAAS_API_KEY=$aact_hmlg_sandbox
# Where Asaas webhooks are POSTed: your app's webhook endpoint.
ASAAS_WEBHOOK_URL=http://localhost:3000/webhooks/asaas
# Sent as the asaas-access-token header on every webhook.
ASAAS_WEBHOOK_TOKEN=change-me
